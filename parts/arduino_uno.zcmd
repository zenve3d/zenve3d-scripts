zcmd 1
# Arduino Uno R3 — the PCB outline with its four mounting holes, the two
# connectors that overhang the plug edge (USB-B and the DC barrel jack), and
# enough of the top side to recognise it: the four female headers with their
# pin holes, the ATmega328, the USB chip, the regulator, the two capacitors,
# the reset button and the LEDs.
# Origin at the PCB's bottom-left corner (the barrel-jack side), the plug edge
# on x = 0. The outline, the holes and the header grid are the official ones;
# the connectors and components are typical sizes — check the plugs against
# your own board before cutting a case tight to it.
# Every component is its own body, so each carries its own colour; the PCB
# body alone is the board.

param board_len = "68.58" -> $board_len
param board_w   = "53.34" -> $board_w
param bump      = "2.54"  -> $bump
param pcb       = "1.6"   -> $pcb
param hole_d    = "3.2"   -> $hole_d

# USB-B jack: 12 wide, 16 long, 10.9 tall, sticks 6.2 past the edge
param usb_w     = "12"   -> $usb_w
param usb_len   = "16"   -> $usb_len
param usb_h     = "10.9" -> $usb_h
param usb_over  = "6.2"  -> $usb_over
param usb_y     = "38.1" -> $usb_y

# DC barrel jack: 9 wide, 14 long, 11 tall, sticks 1.8 past the edge
param jack_w    = "9"    -> $jack_w
param jack_len  = "14"   -> $jack_len
param jack_h    = "11"   -> $jack_h
param jack_over = "1.8"  -> $jack_over
param jack_y    = "7.6"  -> $jack_y

# Headers: 0.1" pitch, 8.5 tall, square pin sockets
param pitch     = "2.54" -> $pitch
param hdr_h     = "8.5"  -> $hdr_h
param pin_sq    = "1"    -> $pin_sq
param pin_depth = "6"    -> $pin_depth

# Components
param chip_h    = "6"    -> $chip_h
param button_h  = "3.5"  -> $button_h
param cap_d     = "6.3"  -> $cap_d
param cap_h     = "5.8"  -> $cap_h

# --- the PCB ----------------------------------------------------------------
sketch on XY -> $s1 $o1 $xt1 $yt1 $xa1 $ya1
rename feature $s1 = "PCB outline"

point $s1 at (0, 0)          -> $q0
point $s1 at (66.04, 0)      -> $q1
point $s1 at (66.04, 2.54)   -> $q2
point $s1 at (68.58, 5.08)   -> $q3
point $s1 at (68.58, 38.1)   -> $q4
point $s1 at (66.04, 40.64)  -> $q5
point $s1 at (66.04, 52.07)  -> $q6
point $s1 at (64.77, 53.34)  -> $q7
point $s1 at (0, 53.34)      -> $q8
line $s1 from $q0 to $q1 -> $e0
line $s1 from $q1 to $q2 -> $e1
line $s1 from $q2 to $q3 -> $e2
line $s1 from $q3 to $q4 -> $e3
line $s1 from $q4 to $q5 -> $e4
line $s1 from $q5 to $q6 -> $e5
line $s1 from $q6 to $q7 -> $e6
line $s1 from $q7 to $q8 -> $e7
line $s1 from $q8 to $q0 -> $e8

constrain $s1 coincident $q0 $o1
constrain $s1 horizontal $e0
constrain $s1 horizontal $e7
constrain $s1 vertical $e1
constrain $s1 vertical $e3
constrain $s1 vertical $e5
constrain $s1 vertical $e8

dim $s1 from $q8 to $xa1 = "board_w"
dim $s1 from $q3 to $ya1 = "board_len"
dim $s1 from $q1 to $ya1 = "board_len - bump"
dim $s1 from $q5 to $ya1 = "board_len - bump"
dim $s1 from $q2 to $xa1 = "bump"
dim $s1 from $q3 to $xa1 = "2 * bump"
dim $s1 from $q4 to $xa1 = "38.1"
dim $s1 from $q5 to $xa1 = "38.1 + bump"
dim $s1 from $q6 to $xa1 = "board_w - bump / 2"
dim $s1 from $q7 to $ya1 = "board_len - bump * 3 / 2"

# Mounting holes, from the Arduino drawing (0.1" grid)
circle $s1 at (13.97, 2.54) radius "hole_d / 2" -> $h1 $hc1 $hr1
dim $s1 from $h1 to $ya1 = "13.97"
dim $s1 from $h1 to $xa1 = "2.54"
circle $s1 at (15.24, 50.8) radius "hole_d / 2" -> $h2 $hc2 $hr2
dim $s1 from $h2 to $ya1 = "15.24"
dim $s1 from $h2 to $xa1 = "50.8"
circle $s1 at (66.04, 7.62) radius "hole_d / 2" -> $h3 $hc3 $hr3
dim $s1 from $h3 to $ya1 = "66.04"
dim $s1 from $h3 to $xa1 = "7.62"
circle $s1 at (66.04, 35.56) radius "hole_d / 2" -> $h4 $hc4 $hr4
dim $s1 from $h4 to $ya1 = "66.04"
dim $s1 from $h4 to $xa1 = "35.56"
!pump
!assert dof $s1 == 0
!assert regions $s1 == 5
!assert region $s1 0 entities == ($e0, $e1, $e2, $e3, $e4, $e5, $e6, $e7, $e8)

# Region 0 is the board with the four holes through it
extrude profile($s1, 0) distance "pcb" -> $board $dt
rename body $board = "Arduino Uno"
material $board = "PCB" rgb 00878f
!pump
!assert feature $board == ok

# --- the connectors, standing on the top of the PCB --------------------------
plane on XY offset "0" "0" "pcb" rotate "0" "0" "0" -> $top
sketch on $top -> $s2 $o2 $xt2 $yt2 $xa2 $ya2
rename feature $s2 = "Connectors"

rect $s2 at (-6.2, 32.1) width "usb_len" height "usb_w" -> $u0 $u1 $u2 $u3 $ul0 $ul1 $ul2 $ul3 $uc0 $uc1 $uc2 $uc3 $ud1 $ud2
dim $s2 from $u0 to $ya2 = "usb_over"
dim $s2 from $u0 to $xa2 = "usb_y - usb_w / 2"

rect $s2 at (-1.8, 3.1) width "jack_len" height "jack_w" -> $j0 $j1 $j2 $j3 $jl0 $jl1 $jl2 $jl3 $jc0 $jc1 $jc2 $jc3 $jd1 $jd2
dim $s2 from $j0 to $ya2 = "jack_over"
dim $s2 from $j0 to $xa2 = "jack_y - jack_w / 2"
!pump
!assert dof $s2 == 0
!assert regions $s2 == 2
!assert region $s2 0 entities == ($ul0, $ul1, $ul2, $ul3)
!assert region $s2 1 entities == ($jl0, $jl1, $jl2, $jl3)

extrude profile($s2, 0) distance "usb_h" -> $usb $duh
rename body $usb = "USB-B"
material $usb = "Steel" rgb c4c6cc
extrude profile($s2, 1) distance "jack_h" -> $jack $djh
rename body $jack = "DC jack"
material $jack = "Black plastic" rgb 2b2b30
!pump
!assert feature $usb == ok
!assert feature $jack == ok

# --- the headers --------------------------------------------------------------
# Official Uno grid: rows centred on y = 2.54 and y = 50.8; the famous 0.16"
# gap sits between D7 and D8.
sketch on $top -> $s3 $o3 $xt3 $yt3 $xa3 $ya3
rename feature $s3 = "Headers"
rect $s3 at (17.526, 49.53) width "10 * pitch" height "pitch" -> $a0 $a1 $a2 $a3 $al0 $al1 $al2 $al3 $ac0 $ac1 $ac2 $ac3 $ad1 $ad2
dim $s3 from $a0 to $ya3 = "17.526"
dim $s3 from $a0 to $xa3 = "50.8 - pitch / 2"
rect $s3 at (44.45, 49.53) width "8 * pitch" height "pitch" -> $b0 $b1 $b2 $b3 $bl0 $bl1 $bl2 $bl3 $bc0 $bc1 $bc2 $bc3 $bd1 $bd2
dim $s3 from $b0 to $ya3 = "44.45"
dim $s3 from $b0 to $xa3 = "50.8 - pitch / 2"
rect $s3 at (26.67, 1.27) width "8 * pitch" height "pitch" -> $c0 $c1 $c2 $c3 $cl0 $cl1 $cl2 $cl3 $cc0 $cc1 $cc2 $cc3 $cd1 $cd2
dim $s3 from $c0 to $ya3 = "26.67"
dim $s3 from $c0 to $xa3 = "pitch / 2"
rect $s3 at (49.53, 1.27) width "6 * pitch" height "pitch" -> $d0 $d1 $d2 $d3 $dl0 $dl1 $dl2 $dl3 $dc0 $dc1 $dc2 $dc3 $dd1 $dd2
dim $s3 from $d0 to $ya3 = "49.53"
dim $s3 from $d0 to $xa3 = "pitch / 2"
!pump
!assert dof $s3 == 0
!assert regions $s3 == 4

extrude profile($s3, 0) profile($s3, 1) profile($s3, 2) profile($s3, 3) distance "hdr_h" -> $hdr $dhh
rename body $hdr = "Headers"
material $hdr = "Black plastic" rgb 1e1e22
!pump
!assert feature $hdr == ok

# One pin socket at the first pin of each header, then patterned along it
plane on XY offset "0" "0" "pcb + hdr_h" rotate "0" "0" "0" -> $hdr_top
sketch on $hdr_top -> $s4 $o4 $xt4 $yt4 $xa4 $ya4
rename feature $s4 = "Pin sockets"
rect $s4 at (18.296, 50.3) width "pin_sq" height "pin_sq" -> $k0 $k1 $k2 $k3 $kl0 $kl1 $kl2 $kl3 $kc0 $kc1 $kc2 $kc3 $kd1 $kd2
dim $s4 from $k0 to $ya4 = "17.526 + pitch / 2 - pin_sq / 2"
dim $s4 from $k0 to $xa4 = "50.8 - pin_sq / 2"
rect $s4 at (45.22, 50.3) width "pin_sq" height "pin_sq" -> $m0 $m1 $m2 $m3 $ml0 $ml1 $ml2 $ml3 $mc0 $mc1 $mc2 $mc3 $md1 $md2
dim $s4 from $m0 to $ya4 = "44.45 + pitch / 2 - pin_sq / 2"
dim $s4 from $m0 to $xa4 = "50.8 - pin_sq / 2"
rect $s4 at (27.44, 2.04) width "pin_sq" height "pin_sq" -> $n0 $n1 $n2 $n3 $nl0 $nl1 $nl2 $nl3 $nc0 $nc1 $nc2 $nc3 $nd1 $nd2
dim $s4 from $n0 to $ya4 = "26.67 + pitch / 2 - pin_sq / 2"
dim $s4 from $n0 to $xa4 = "pitch - pin_sq / 2"
rect $s4 at (50.3, 2.04) width "pin_sq" height "pin_sq" -> $r0 $r1 $r2 $r3 $rl0 $rl1 $rl2 $rl3 $rc0 $rc1 $rc2 $rc3 $rd1 $rd2
dim $s4 from $r0 to $ya4 = "49.53 + pitch / 2 - pin_sq / 2"
dim $s4 from $r0 to $xa4 = "pitch - pin_sq / 2"
!pump
!assert dof $s4 == 0
!assert regions $s4 == 4

extrude profile($s4, 0) distance "-pin_depth" cut $hdr -> $pk $dpk
extrude profile($s4, 1) distance "-pin_depth" cut $hdr -> $pm $dpm
extrude profile($s4, 2) distance "-pin_depth" cut $hdr -> $pn $dpn
extrude profile($s4, 3) distance "-pin_depth" cut $hdr -> $pr $dpr
pattern grid count "10" step "pitch" "0" "0" $pk -> $gk
pattern grid count "8" step "pitch" "0" "0" $pm -> $gm
pattern grid count "8" step "pitch" "0" "0" $pn -> $gn
pattern grid count "6" step "pitch" "0" "0" $pr -> $gr
!pump
!assert feature $gk == ok
!assert feature $gm == ok
!assert feature $gn == ok
!assert feature $gr == ok

# --- the chips, regulator, reset button and LEDs -------------------------------
sketch on $top -> $s5 $o5 $xt5 $yt5 $xa5 $ya5
rename feature $s5 = "Components"
# ATmega328P, DIP-28 in its socket
rect $s5 at (29.75, 15.25) width "35.56" height "7.5" -> $t0 $t1 $t2 $t3 $tl0 $tl1 $tl2 $tl3 $tc0 $tc1 $tc2 $tc3 $td1 $td2
dim $s5 from $t0 to $ya5 = "29.75"
dim $s5 from $t0 to $xa5 = "15.25"
# ATmega16U2, the USB controller
rect $s5 at (17.5, 31.9) width "5" height "5" -> $v0 $v1 $v2 $v3 $vl0 $vl1 $vl2 $vl3 $vc0 $vc1 $vc2 $vc3 $vd1 $vd2
dim $s5 from $v0 to $ya5 = "17.5"
dim $s5 from $v0 to $xa5 = "31.9"
# 5 V regulator
rect $s5 at (5.25, 17) width "6.5" height "7" -> $w0 $w1 $w2 $w3 $wl0 $wl1 $wl2 $wl3 $wc0 $wc1 $wc2 $wc3 $wd1 $wd2
dim $s5 from $w0 to $ya5 = "5.25"
dim $s5 from $w0 to $xa5 = "17"
# reset button body
rect $s5 at (4, 46) width "6" height "6" -> $x0 $x1 $x2 $x3 $xl0 $xl1 $xl2 $xl3 $xc0 $xc1 $xc2 $xc3 $xd1 $xd2
dim $s5 from $x0 to $ya5 = "4"
dim $s5 from $x0 to $xa5 = "46"
# LEDs: L, TX, RX, ON
rect $s5 at (28, 38.5) width "2" height "1.2" -> $la0 $la1 $la2 $la3 $lal0 $lal1 $lal2 $lal3 $lac0 $lac1 $lac2 $lac3 $lad1 $lad2
dim $s5 from $la0 to $ya5 = "28"
dim $s5 from $la0 to $xa5 = "38.5"
rect $s5 at (28, 35.8) width "2" height "1.2" -> $lb0 $lb1 $lb2 $lb3 $lbl0 $lbl1 $lbl2 $lbl3 $lbc0 $lbc1 $lbc2 $lbc3 $lbd1 $lbd2
dim $s5 from $lb0 to $ya5 = "28"
dim $s5 from $lb0 to $xa5 = "35.8"
rect $s5 at (28, 33.1) width "2" height "1.2" -> $lc0 $lc1 $lc2 $lc3 $lcl0 $lcl1 $lcl2 $lcl3 $lcc0 $lcc1 $lcc2 $lcc3 $lcd1 $lcd2
dim $s5 from $lc0 to $ya5 = "28"
dim $s5 from $lc0 to $xa5 = "33.1"
rect $s5 at (60, 35.8) width "2" height "1.2" -> $ld0 $ld1 $ld2 $ld3 $ldl0 $ldl1 $ldl2 $ldl3 $ldc0 $ldc1 $ldc2 $ldc3 $ldd1 $ldd2
dim $s5 from $ld0 to $ya5 = "60"
dim $s5 from $ld0 to $xa5 = "35.8"
# the two electrolytic capacitors
circle $s5 at (17.5, 10) radius "cap_d / 2" -> $ca $cac $car
dim $s5 from $ca to $ya5 = "17.5"
dim $s5 from $ca to $xa5 = "10"
circle $s5 at (24.9, 10) radius "cap_d / 2" -> $cb $cbc $cbr
dim $s5 from $cb to $ya5 = "24.9"
dim $s5 from $cb to $xa5 = "10"
!pump
!assert dof $s5 == 0
!assert regions $s5 == 10
!assert region $s5 0 entities == ($tl0, $tl1, $tl2, $tl3)
!assert region $s5 3 entities == ($xl0, $xl1, $xl2, $xl3)
!assert region $s5 8 entities == ($cac)

extrude profile($s5, 0) distance "chip_h" -> $mcu $dmcu
rename body $mcu = "ATmega328P"
material $mcu = "Black epoxy" rgb 2a2d36
extrude profile($s5, 1) distance "1" -> $u2 $du2
rename body $u2 = "ATmega16U2"
material $u2 = "Black epoxy" rgb 2a2d36
extrude profile($s5, 2) distance "2.3" -> $reg $dreg
rename body $reg = "Regulator"
material $reg = "Black epoxy" rgb 2a2d36
extrude profile($s5, 3) distance "button_h" -> $btn $dbtn
rename body $btn = "Reset button"
material $btn = "Steel" rgb a4a7b0
extrude profile($s5, 4) profile($s5, 5) profile($s5, 6) profile($s5, 7) distance "0.8" -> $leds $dleds
rename body $leds = "LEDs"
material $leds = "LED" rgb eef0f2
extrude profile($s5, 8) profile($s5, 9) distance "cap_h" -> $caps $dcaps
rename body $caps = "Capacitors"
material $caps = "Aluminium" rgb e2e4e8
!pump
!assert feature $mcu == ok
!assert feature $u2 == ok
!assert feature $reg == ok
!assert feature $btn == ok
!assert feature $leds == ok
!assert feature $caps == ok

# The reset button's red cap, on top of its body
plane on XY offset "0" "0" "pcb + button_h" rotate "0" "0" "0" -> $btn_top
sketch on $btn_top -> $s6 $o6 $xt6 $yt6 $xa6 $ya6
rename feature $s6 = "Reset cap"
circle $s6 at (7, 49) radius "1.75" -> $bc $bcc $bcr
dim $s6 from $bc to $ya6 = "7"
dim $s6 from $bc to $xa6 = "49"
!pump
!assert dof $s6 == 0
extrude profile($s6, 0) distance "1" -> $cap $dcap
rename body $cap = "Reset cap"
material $cap = "Red" rgb e8604c
!pump
!assert feature $cap == ok
!assert bodies == 11
